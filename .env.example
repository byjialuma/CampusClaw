# 复制为 .env 后按需修改；切勿提交真实口令
# MySQL（compose 自动创建数据库与业务账号）
MYSQL_DATABASE=campusclaw
MYSQL_USER=campusclaw
MYSQL_PASSWORD=change_me_db_password
MYSQL_ROOT_PASSWORD=change_me_root_password

# 预置种子账号口令（仅首次播种时写入，重启不会覆盖已改密码）
SEED_TEACHER_A_USERNAME=teacherA
SEED_TEACHER_A_PASSWORD=change_me_teacher_a
SEED_STUDENT_A1_USERNAME=studentA1
SEED_STUDENT_A1_PASSWORD=change_me_student_a1
SEED_STUDENT_B1_USERNAME=studentB1
SEED_STUDENT_B1_PASSWORD=change_me_student_b1

# 服务端会话有效期（秒），默认 8 小时
SESSION_TTL_SECONDS=28800

# 向量数据库（compose 内部服务，勿改；不向宿主机发布端口）
QDRANT_URL=http://qdrant:6333

# 文本向量化：provider=stub 时无需任何密钥，仅适用于测试/离线（无语义检索能力）
# 生产请改用 provider=openai 并填写国内云厂商的 OpenAI 兼容端点，例如智谱 embedding-3（2048 维）
EMBEDDING_PROVIDER=stub
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_API_KEY=replace-with-your-cloud-api-key
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIM=2048

# 语义检索每次返回的最大片段数（1-10）
SEARCH_TOP_K=5
