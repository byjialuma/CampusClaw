# 复制为 .env 后按需修改；切勿提交真实口令
# MySQL（compose 自动创建数据库与业务账号）
MYSQL_DATABASE=campusclaw
MYSQL_USER=campusclaw
MYSQL_PASSWORD=change_me_db_password
MYSQL_ROOT_PASSWORD=change_me_root_password

# 预置种子账号口令（仅首次播种时写入，重启不会覆盖已改密码）
SEED_TEACHER_A_USERNAME=teacherA
SEED_TEACHER_A_PASSWORD=change_me_teacher_a
SEED_STUDENT_A1_USERNAME=studentA1
SEED_STUDENT_A1_PASSWORD=change_me_student_a1
SEED_STUDENT_B1_USERNAME=studentB1
SEED_STUDENT_B1_PASSWORD=change_me_student_b1

# 服务端会话有效期（秒），默认 8 小时
SESSION_TTL_SECONDS=28800
