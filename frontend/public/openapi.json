          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["智能体"],
        "summary": "新建智能体（仅教师）",
        "description": "名称 1–120 字、提示词 1–2000 字；同班重名返回 400。新建后需再绑定技能/材料。",
        "requestBody": {
          "required": true,
