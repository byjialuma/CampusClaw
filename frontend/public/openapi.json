    "/api/tutor/assistant/skills/{id}/resources": {
      "get": {
        "tags": ["解题助手"],
        "summary": "读取技能包内资源（仅教师）",
        "description": "按 `path` 读取包内单个文件；路径限定在 references/、assets/、scripts/ 内，越界返回 400，跨班或文件不存在返回 404。文本资源返回 `text/plain; charset=utf-8`，其余为 `application/octet-stream`，并带 `Cache-Control: no-store`。脚本仅可下载查看，不会被执行。",
        "parameters": [
