        "parameters": [{ "$ref": "#/components/parameters/AgentId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AgentMaterialBindingRequest" },
              "example": { "handoutIds": [1, 2] }
            }
          }
        },
        "responses": {
          "200": {
            "description": "替换成功（返回更新后的智能体视图）",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Agent" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/tutor/mcp/servers": {
      "get": {
        "tags": ["MCP 工具"],
        "summary": "本班 MCP 服务器列表（仅教师）",
        "description": "响应**绝不回传令牌明文**，只回 `hasAuth` 布尔；`tools` 为上次连接（`tools/list`）缓存到的工具清单。",
        "responses": {
          "200": {
            "description": "服务器数组",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/MCPServer" } } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "tags": ["MCP 工具"],
        "summary": "登记 MCP 服务器（仅教师）",
        "description": "名称须以小写字母开头、仅含小写字母/数字/下划线/连字符，本班内唯一，重名返回 400；`baseUrl` 须为合法 http(s) 地址。`authToken` 为 Bearer 令牌，只存服务端。登记后需再调用 connect 才会发现工具。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MCPServerSaveRequest" },
              "example": { "name": "campus-tools", "baseUrl": "http://mcp-demo:8090", "authToken": "<Bearer 令牌>" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "登记成功（未连接）",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MCPServer" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/tutor/mcp/servers/{id}": {
      "put": {
        "tags": ["MCP 工具"],
        "summary": "修改 MCP 服务器（仅教师）",
        "description": "跨班或不存在返回 404；同班重名返回 400。`authToken` 缺省或为 null 时保留原令牌，给定值则覆盖。",
        "parameters": [{ "$ref": "#/components/parameters/MCPServerId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/MCPServerSaveRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MCPServer" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["MCP 工具"],
        "summary": "删除 MCP 服务器（仅教师）",
        "description": "跨班或不存在返回 404。删除后历史审计仍保留 `serverName` 快照（`serverId` 置空）。",
        "parameters": [{ "$ref": "#/components/parameters/MCPServerId" }],
        "responses": {
          "200": {
            "description": "删除成功",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ok" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/tutor/mcp/servers/{id}/connect": {
      "post": {
        "tags": ["MCP 工具"],
        "summary": "连接并发现工具（仅教师）",
        "description": "对本班服务器发起 JSON-RPC `initialize` 握手与 `tools/list`，成功后返回 `connected: true` 与最新 `tools` 清单，并写入缓存；**这是「列出工具」的入口**。\n\n连接失败（不可达、握手或 tools/list 出错）返回 502，同时保持 `connected: false`、清空工具缓存并记录 `lastError`。技能正文引用某 MCP 工具时，必须先完成本步，否则保存技能会被 400 拒绝。",
        "parameters": [{ "$ref": "#/components/parameters/MCPServerId" }],
        "responses": {
          "200": {
            "description": "连接成功且工具清单已缓存",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MCPServer" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "502": {
            "description": "连接失败（服务不可达或握手/工具发现失败）",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "连接 MCP 服务器失败" } } }
          }
        }
      }
    },
    "/api/tutor/mcp/servers/{id}/disconnect": {
      "post": {
        "tags": ["MCP 工具"],
        "summary": "断开 MCP 服务器（仅教师）",
        "description": "仅把本班该服务器标记为未连接，不改动令牌与名称。跨班或不存在返回 404。断开后引用其工具的技能在提问时不会被调用（审计记为 denied）。",
        "parameters": [{ "$ref": "#/components/parameters/MCPServerId" }],
        "responses": {
          "200": {
            "description": "已断开",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MCPServer" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/tutor/mcp/calls": {
      "get": {
        "tags": ["MCP 工具"],
        "summary": "MCP 工具调用审计（仅教师）",
        "description": "返回本班最近 50 条调用记录，含 `toolRef`（`tool@server`）、`status`（success / denied / error）、`username`（发起提问用户快照）与 `createdAt`。班级隔离在服务端强制生效，跨班记录不会返回；学生调用返回 403。",
        "responses": {
          "200": {
            "description": "审计记录数组（新→旧）",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/MCPCall" } } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "POST /api/sessions 返回的 accessToken"
      }
    },
    "parameters": {
      "MaterialId": { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 }, "description": "材料 ID" },
      "ConversationId": { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 }, "description": "会话 ID" },
      "SkillId": { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 }, "description": "技能 ID" },
      "AgentId": { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 }, "description": "智能体 ID" },
      "MCPServerId": { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 }, "description": "MCP 服务器 ID" }
    },
    "responses": {
      "BadRequest": {
        "description": "参数错误",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "请求格式错误" } } }
      },
      "Unauthorized": {
        "description": "未登录或会话已失效",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "未登录或会话已失效" } } }
      },
      "Forbidden": {
        "description": "角色或班级越权",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "无权访问该资源" } } }
      },
      "NotFound": {
        "description": "资源不存在（含跨班防探测）",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "资源不存在" } } }
      },
      "ServiceUnavailable": {
        "description": "下游依赖暂不可用",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "服务暂不可用" } } }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": { "error": { "type": "string" } },
        "required": ["error"]
      },
      "Ok": {
        "type": "object",
        "properties": { "ok": { "type": "boolean", "example": true } }
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["ok", "degraded"] },
          "db": { "type": "string", "enum": ["up", "down"] },
          "vector": { "type": "string", "enum": ["up", "down"] }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string" },
          "password": { "type": "string", "format": "password" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "user": { "$ref": "#/components/schemas/Me" },
          "accessToken": { "type": "string", "description": "JWT，填入右上角 Authorize" },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "username": { "type": "string", "example": "teacherA" },
          "displayName": { "type": "string", "example": "教师A" },
          "role": { "type": "string", "enum": ["teacher", "student"] },
          "classId": { "type": "integer", "example": 1 },
          "className": { "type": "string", "example": "软件工程 1 班" }
        }
      },
      "Student": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 2 },
          "username": { "type": "string", "example": "studentA1" },
          "displayName": { "type": "string", "example": "学生A1" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Material": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "第三章讲义.pdf" },
          "fileType": { "type": "string", "enum": ["txt", "md", "pdf"] },
          "sizeBytes": { "type": "integer", "example": 20480 },
          "uploaderName": { "type": "string", "example": "教师A" },
          "createdAt": { "type": "string", "format": "date-time" },
          "indexStatus": { "type": "string", "enum": ["pending", "indexed", "failed"], "description": "向量索引状态" }
        }
      },
      "Locator": {
        "type": "object",
        "description": "分片在原文档中的位置：PDF 用 page、Markdown 用 path（章节路径）、TXT 用 startLine/endLine",
        "properties": {
          "kind": { "type": "string", "enum": ["page", "heading", "lines"] },
          "page": { "type": "integer", "example": 3 },
          "path": { "type": "string", "example": "第 3 章 / 3.2 节" },
          "startLine": { "type": "integer", "example": 40 },
          "endLine": { "type": "integer", "example": 52 }
        }
      },
      "SearchResult": {
        "type": "object",
        "properties": {
          "documentId": { "type": "integer" },
          "chunkId": { "type": "string" },
          "fileName": { "type": "string" },
          "fileType": { "type": "string" },
          "snippet": { "type": "string", "description": "命中分片文本" },
          "score": { "type": "number", "format": "float" },
          "locator": { "$ref": "#/components/schemas/Locator" }
        }
      },
      "Citation": {
        "type": "object",
        "properties": {
          "documentId": { "type": "integer" },
          "fileName": { "type": "string" },
          "fileType": { "type": "string" },
          "snippet": { "type": "string" },
          "locator": { "$ref": "#/components/schemas/Locator" },
          "score": { "type": "number", "format": "float" }
        }
      },
      "QAResult": {
        "type": "object",
        "properties": {
          "answer": { "type": "string" },
          "citations": { "type": "array", "items": { "$ref": "#/components/schemas/Citation" } }
        }
      },
      "Conversation": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "SkillRef": {
        "type": "object",
        "description": "某轮回答启用技能的快照（技能被删除后历史仍可展示名称）",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" }
        }
      },
      "Message": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "conversationId": { "type": "integer" },
          "role": { "type": "string", "enum": ["user", "assistant"] },
          "content": { "type": "string" },
          "citations": { "type": "array", "items": { "$ref": "#/components/schemas/Citation" } },
          "skillsUsed": { "type": "array", "items": { "$ref": "#/components/schemas/SkillRef" } },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Skill": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "content": { "type": "string" },
          "source": { "type": "string", "enum": ["seed", "upload", "online", "package"], "description": "seed=内置 / upload=上传 / online=自建 / package=技能包" },
          "builtin": { "type": "boolean", "description": "内置技能禁止删除" },
          "enabled": { "type": "boolean" },
          "slug": { "type": "string", "description": "技能包唯一标识（仅 package 来源）" },
          "resources": { "type": "array", "items": { "type": "string" }, "description": "运行时按需加载的资源白名单（仅 package 来源）" }
        }
      },
      "SkillPackageFile": {
        "type": "object",
        "description": "技能包内落盘的一个文件条目",
        "properties": {
          "path": { "type": "string", "example": "references/pythagorean-theorem.md" },
          "kind": { "type": "string", "enum": ["references", "assets", "scripts"], "description": "按顶层目录分类" },
          "size": { "type": "integer", "format": "int64", "description": "文件字节数" }
        }
      },
      "SkillPackageView": {
        "allOf": [{ "$ref": "#/components/schemas/Skill" }],
        "description": "技能包详情：技能字段 + 工具引用 + 包内文件清单",
        "properties": {
          "tools": { "type": "array", "items": { "$ref": "#/components/schemas/ToolRef" } },
          "files": { "type": "array", "items": { "$ref": "#/components/schemas/SkillPackageFile" } }
        }
      },
      "SkillResourceStatus": {
        "type": "object",
        "description": "本轮技能资源加载状态（SSE meta.skillResources）",
        "properties": {
          "path": { "type": "string" },
          "loaded": { "type": "boolean" },
          "truncated": { "type": "boolean", "description": "是否因体积上限被截断" },
          "error": { "type": "string", "description": "加载失败原因；失败不阻断回答" }
        }
      },
      "AssistantConfig": {
        "type": "object",
        "description": "本班技能库视图（仅教师）；提示词已随智能体配置，不在此返回。",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string", "example": "A班·解题助手" },
          "skills": { "type": "array", "items": { "$ref": "#/components/schemas/SkillView" } }
        }
      },
      "SkillView": {
        "allOf": [{ "$ref": "#/components/schemas/Skill" }],
        "description": "技能 + 从正文解析出的工具引用（供界面展示）",
        "properties": { "tools": { "type": "array", "items": { "$ref": "#/components/schemas/ToolRef" } } }
      },
      "ToolRef": {
        "type": "object",
        "description": "技能正文声明的一条工具引用",
        "properties": {
          "raw": { "type": "string", "example": "formula_hint@campus-tools" },
          "name": { "type": "string", "example": "formula_hint", "description": "工具名，小写字母开头，仅含小写字母、数字与下划线" },
          "server": { "type": "string", "example": "campus-tools", "description": "服务器名；内置引用时为空" },
          "builtin": { "type": "boolean", "description": "是否为内置引用 knowledge_search" }
        }
      },
      "Agent": {
        "type": "object",
        "description": "教师视图含 systemPrompt/skillIds/handoutIds；学生视图仅有 id/name/updatedAt。",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "systemPrompt": { "type": "string" },
          "skillIds": { "type": "array", "items": { "type": "integer" }, "description": "绑定的技能 ID（教师视图）" },
          "handoutIds": { "type": "array", "items": { "type": "integer" }, "description": "绑定的材料 ID（教师视图）" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "name"]
      },
      "AgentSaveRequest": {
        "type": "object",
        "required": ["name", "systemPrompt"],
        "properties": {
          "name": { "type": "string", "maxLength": 120 },
          "systemPrompt": { "type": "string", "maxLength": 2000 }
        }
      },
      "AgentSkillBindingRequest": {
        "type": "object",
        "required": ["skillIds"],
        "properties": {
          "skillIds": { "type": "array", "items": { "type": "integer" }, "description": "最终绑定的技能集合；空数组表示清空" }
        }
      },
      "AgentMaterialBindingRequest": {
        "type": "object",
        "required": ["handoutIds"],
        "properties": {
          "handoutIds": { "type": "array", "items": { "type": "integer" }, "description": "最终绑定的材料集合；空数组表示清空" }
        }
      },
      "MCPTool": {
        "type": "object",
        "description": "连接时由 tools/list 发现的工具条目",
        "properties": {
          "name": { "type": "string", "example": "formula_hint", "description": "工具名：小写字母开头，仅含小写字母、数字与下划线" },
          "description": { "type": "string" },
          "inputSchema": { "type": "object", "description": "JSON Schema 形式的入参定义" }
        },
        "required": ["name"]
      },
      "MCPServer": {
        "type": "object",
        "description": "响应绝不含 authToken 明文，仅回 hasAuth 布尔。",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string", "example": "campus-tools", "description": "小写字母开头，仅含小写字母/数字/下划线/连字符；本班内唯一" },
          "baseUrl": { "type": "string", "format": "uri", "example": "http://mcp-demo:8090" },
          "hasAuth": { "type": "boolean", "description": "是否已配置 Bearer 令牌（不回传明文）" },
          "connected": { "type": "boolean" },
          "tools": { "type": "array", "items": { "$ref": "#/components/schemas/MCPTool" }, "description": "上次 tools/list 缓存到的工具清单" },
          "lastError": { "type": "string", "description": "最近一次连接失败原因" }
        },
        "required": ["id", "name", "baseUrl", "hasAuth", "connected"]
      },
      "MCPServerSaveRequest": {
        "type": "object",
        "required": ["name", "baseUrl"],
        "properties": {
          "name": { "type": "string", "maxLength": 120 },
          "baseUrl": { "type": "string", "format": "uri", "maxLength": 512 },
          "authToken": { "type": "string", "description": "Bearer 令牌，仅存服务端；更新时缺省或 null 表示保留原令牌" }
        }
      },
      "MCPCall": {
        "type": "object",
        "description": "一次远端工具调用尝试的审计记录",
        "properties": {
          "id": { "type": "integer" },
          "serverId": { "type": "integer", "nullable": true },
          "serverName": { "type": "string", "example": "campus-tools", "description": "写入时的服务器名快照" },
          "toolRef": { "type": "string", "example": "formula_hint@campus-tools" },
          "status": { "type": "string", "enum": ["success", "denied", "error"] },
          "error": { "type": "string" },
          "durationMs": { "type": "integer" },
          "userId": { "type": "integer", "nullable": true },
          "username": { "type": "string", "description": "发起提问的用户名快照" },
          "conversationId": { "type": "integer", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "security": [{ "bearerAuth": [] }]
}
