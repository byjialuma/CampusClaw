{
  "openapi": "3.0.3",
  "info": {
    "title": "CampusClaw API",
    "version": "1.0.0",
    "description": "班级知识库与解题助手后端接口。\n\n## 认证方式\n\n除「登录」「健康检查」「票据下载」外，所有接口都需要 JWT：\n\n1. 调用 `POST /api/sessions` 取得 `accessToken`；\n2. 点击本页右上角 **Authorize**，填入 `accessToken`（不要加 `Bearer` 前缀，Swagger 会自动加）；\n3. 之后所有 Try it out 请求都会携带 `Authorization: Bearer <token>`。\n\n## 角色与隔离\n\n- 角色：`teacher`（教师）/ `student`（学生），写在 JWT 中；\n- 班级隔离在服务端强制生效：`class_id` 一律取自 JWT，客户端传了也会被忽略；\n- 学生调用教师接口返回 `403`；跨班访问资源返回 `403` 或 `404`（视资源类型，防止探测）。\n\n## 通用错误\n\n错误响应统一为 JSON：`{\"error\": \"错误文案\"}`。常见状态码：`400` 参数错误、`401` 未登录或票据无效、`403` 角色/班级越权、`404` 资源不存在、`409` 冲突、`410` 票据已失效、`503` 下游依赖不可用。"
  },
  "servers": [{ "url": "/", "description": "同源（经 Nginx 反代至后端）" }],
  "tags": [
    { "name": "系统", "description": "健康检查" },
    { "name": "认证", "description": "登录、登出、当前用户" },
    { "name": "班级", "description": "班级学生名单（仅教师）" },
    { "name": "材料", "description": "讲义上传、列表、预览、下载" },
    { "name": "检索与问答", "description": "本班知识库语义检索与知识问答" },
    { "name": "解题助手", "description": "会话、流式回答与技能管理" },
    { "name": "智能体", "description": "多智能体列表/新建/修改/删除，以及技能与材料的绑定（写操作仅教师）" },
    { "name": "MCP 工具", "description": "MCP 服务器登记、连接与工具发现、断开，以及调用审计（仅教师）" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["系统"],
        "summary": "健康检查（无需登录）",
        "description": "MySQL 与向量库均可达才返回 200，任一不可达返回 503。",
        "security": [],
        "responses": {
          "200": {
            "description": "全部依赖正常",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" }, "example": { "status": "ok", "db": "up", "vector": "up" } } }
          },
          "503": {
            "description": "存在不可用依赖",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" }, "example": { "status": "degraded", "db": "up", "vector": "down" } } }
          }
        }
      }
    },
    "/api/sessions": {
      "post": {
        "tags": ["认证"],
        "summary": "登录（无需登录）",
        "description": "用户名密码换取 JWT accessToken。用户不存在与密码错误返回完全一致的 401。",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" },
              "example": { "username": "teacherA", "password": "change_me_teacher_a" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": {
            "description": "用户名或密码错误",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "用户名或密码错误" } } }
          }
        }
      },
      "delete": {
        "tags": ["认证"],
        "summary": "登出",
        "description": "JWT 无状态，客户端丢弃 token 即可；服务端始终返回 204。",
        "responses": { "204": { "description": "已登出（无响应体）" } }
      }
    },
    "/api/me": {
      "get": {
        "tags": ["认证"],
        "summary": "当前用户信息",
        "responses": {
          "200": {
            "description": "当前登录用户",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Me" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/class/students": {
      "get": {
        "tags": ["班级"],
        "summary": "本班学生名单（仅教师）",
        "description": "返回当前教师所属班级的全部学生，按加入时间升序。班级取自 JWT，学生调用返回 403。",
        "responses": {
          "200": {
            "description": "学生列表（可能为空数组）",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Student" } } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/materials": {
      "get": {
        "tags": ["材料"],
        "summary": "本班材料列表",
        "description": "仅返回当前用户所在班级的材料（服务端按 JWT 班级过滤）。",
        "responses": {
          "200": {
            "description": "材料列表",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "materials": { "type": "array", "items": { "$ref": "#/components/schemas/Material" } } } }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["材料"],
        "summary": "上传材料（仅教师）",
        "description": "multipart 表单上传，文件字段名必须为 `file`。仅支持 txt / md / pdf，大小上限 64KB，扩展名与魔数双重校验。`class_id` 与上传人取自 JWT，忽略客户端声明。返回 201 后异步入向量索引队列。",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": { "file": { "type": "string", "format": "binary", "description": "txt/md/pdf 文件，≤64KB" } }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "上传成功",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Material" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": {
            "description": "学生无权限上传文件",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "学生无权限上传文件" } } }
          }
        }
      }
    },
    "/api/materials/{id}/content": {
      "get": {
        "tags": ["材料"],
        "summary": "读取材料内容（预览）",
        "description": "返回文件原始内容（Content-Type 按文件类型），响应头 `X-File-Name` 为 URL 编码的原始文件名。跨班访问返回 403。",
        "parameters": [{ "$ref": "#/components/parameters/MaterialId" }],
        "responses": {
          "200": { "description": "文件内容", "content": { "text/plain": {}, "text/markdown": {}, "application/pdf": {} } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/materials/{id}/download-ticket": {
      "post": {
        "tags": ["材料"],
        "summary": "创建下载票据",
        "description": "为本班材料创建一次性下载票据（60 秒有效期、单次有效）。",
        "parameters": [{ "$ref": "#/components/parameters/MaterialId" }],
        "responses": {
          "200": {
            "description": "票据创建成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ticket": { "type": "string", "example": "9f2c…64hex" },
                    "fileName": { "type": "string", "example": "第三章讲义.pdf" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/download": {
      "get": {
        "tags": ["材料"],
        "summary": "凭票据下载文件（无需登录）",
        "description": "一次性票据消费：在事务内 `SELECT ... FOR UPDATE` 并标记已用。响应带 `Cache-Control: no-store`。票据缺失 → 401；已使用或过期（>60s）→ 410。",
        "security": [],
        "parameters": [
          { "name": "ticket", "in": "query", "required": true, "schema": { "type": "string" }, "description": "下载票据（由 download-ticket 接口签发）" }
        ],
        "responses": {
          "200": { "description": "文件流（application/octet-stream，Content-Disposition 附件）", "content": { "application/octet-stream": {} } },
          "401": {
            "description": "票据缺失",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "下载凭证缺失" } } }
          },
          "410": {
            "description": "票据已使用或已过期",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "下载凭证已失效，请重新登录" } } }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/search": {
      "get": {
        "tags": ["检索与问答"],
        "summary": "本班知识库语义检索",
        "description": "向量相似度召回，强制按 JWT 班级过滤，禁止跨班混合召回。",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string", "maxLength": 500 }, "description": "查询内容（1–500 字）" }
        ],
        "responses": {
          "200": {
            "description": "检索结果（按相关度降序）",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "results": { "type": "array", "items": { "$ref": "#/components/schemas/SearchResult" } } } }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/qa": {
      "post": {
        "tags": ["检索与问答"],
        "summary": "知识问答",
        "description": "基于本班材料回答问题并附引用。无切片命中时不调用 LLM，直接返回固定句「根据已有材料无法回答该问题」与空引用。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["question"],
                "properties": { "question": { "type": "string", "maxLength": 500 } }
              },
              "example": { "question": "什么是闭包？" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "回答与引用",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/QAResult" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/tutor/conversations": {
      "post": {
        "tags": ["解题助手"],
        "summary": "新建解题会话",
        "description": "会话必须显式绑定本班智能体：`agentId` 取自 `GET /api/tutor/agents`。跨班或不存在返回 404。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["agentId"], "properties": { "agentId": { "type": "integer", "minimum": 1 } } },
              "example": { "agentId": 1 }
            }
          }
        },
        "responses": {
          "201": {
            "description": "会话创建成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "id": { "type": "integer", "example": 12 }, "title": { "type": "string", "example": "新的解题会话" } }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "get": {
        "tags": ["解题助手"],
        "summary": "我的会话列表（新→旧）",
        "responses": {
          "200": {
            "description": "会话数组",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Conversation" } } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/tutor/conversations/{id}/messages": {
      "get": {
        "tags": ["解题助手"],
        "summary": "读取会话消息",
        "description": "仅会话属主可读；他人（含其他班）会话一律 404。",
        "parameters": [{ "$ref": "#/components/parameters/ConversationId" }],
        "responses": {
          "200": {
            "description": "消息数组（assistant 消息可能带 citations / skillsUsed 快照）",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Message" } } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "post": {
        "tags": ["解题助手"],
        "summary": "提问（SSE 流式回答）",
        "description": "以 Server-Sent Events 推送一轮回答。事件序列：`meta`（先于正文，载荷含 citations 引用、skills 本轮命中的技能快照、toolCalls 远端工具调用结果）→ 多个 `delta`（正文增量）→ `done`（含 messageId）或 `error`。\n\n路由与工具：本轮至多命中 1 条技能（候选集为「绑定到本会话智能体且已启用」的技能，按「适用条件」关键词在提问文本中的命中个数计分，取最高分、同分取技能 id 较小者，零命中则不选技能）。命中的技能若声明了 `工具：<name>@<server>`，服务端会在本轮调用对应 MCP 工具，结果作为数据拼入用户消息，调用状态记录在 `meta.toolCalls` 与「MCP 调用审计」中；工具调用失败不阻断回答。\n\n每行格式：`event: <类型>` + `data: <JSON>`。注意 Swagger UI 的 Try it out 无法逐帧渲染 SSE，会一次性展示全部事件流。",
        "parameters": [{ "$ref": "#/components/parameters/ConversationId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["question"],
                "properties": { "question": { "type": "string", "maxLength": 500 } }
              },
              "example": { "question": "这道题该从哪个公式入手？" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SSE 事件流（text/event-stream）",
            "content": {
              "text/event-stream": {
                "schema": { "type": "string", "description": "event: meta/delta/done/error + data: JSON" },
                "example": "event: meta\ndata: {\"citations\":[{\"documentId\":1,\"fileName\":\"讲义.md\",\"fileType\":\"md\",\"snippet\":\"...\",\"locator\":{\"kind\":\"heading\",\"path\":\"第 3 章\"},\"score\":0.83,\"index\":1}],\"skills\":[{\"id\":2,\"name\":\"勾股定理解题引导\"}],\"toolCalls\":[{\"toolRef\":\"formula_hint@campus-tools\",\"serverName\":\"campus-tools\",\"status\":\"success\"}],\"skillResources\":[{\"path\":\"references/pythagorean-theorem.md\",\"loaded\":true}]}\n\nevent: delta\ndata: {\"text\":\"我们先回顾\"}\n\nevent: done\ndata: {\"messageId\":45}\n"
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/tutor/assistant": {
      "get": {
        "tags": ["解题助手"],
        "summary": "本班技能库视图（仅教师）",
        "description": "返回本班助手与其全部技能（含从正文解析出的工具引用）。提示词已随智能体配置，不再在此返回；技能需绑定到智能体才会参与提问路由。",
        "responses": {
          "200": {
            "description": "助手配置与技能列表",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AssistantConfig" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/tutor/assistant/skills": {
      "post": {
        "tags": ["解题助手"],
        "summary": "在线新建技能（仅教师）",
        "description": "名称 1–120 字、内容 1–20000 字。新建后默认停用，需显式启用，并绑定到智能体后才会参与提问路由。\n\n正文可声明工具引用：单独一行 `工具：<tool>@<server>`（多条用 `,`/`，`/`、` 分隔；内置检索写 `knowledge_search`），以及可选一行 `适用条件：<关键词1>,<关键词2>`（关键词须是学生提问里会**字面出现**的词，否则该技能不会被命中）。保存时校验每条 MCP 引用的服务器在本班存在、已连接、且工具在其清单中，任一不满足返回 400。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "content"],
                "properties": {
                  "name": { "type": "string", "maxLength": 120 },
                  "content": { "type": "string", "maxLength": 20000 }
                }
              },
              "example": { "name": "公式回顾", "content": "回答前先回顾相关公式，再引导学生自行推导。" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "技能创建成功（默认停用）",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Skill" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/tutor/assistant/skills/upload": {
      "post": {
        "tags": ["解题助手"],
        "summary": "上传技能文档（仅教师）",
        "description": "multipart 表单，文件字段名 `file`，仅支持 .md / .txt，≤64KB，UTF-8。文件名去扩展名作为默认名称，可用表单字段 `name` 覆盖。\n\n文件正文中的「工具」/「适用条件」语法与 MCP 引用校验同 `POST /api/tutor/assistant/skills`。",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": { "type": "string", "format": "binary", "description": ".md/.txt 文件，≤64KB" },
                  "name": { "type": "string", "description": "可选，覆盖默认技能名" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "技能创建成功（默认停用）",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Skill" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/tutor/assistant/skills/package": {
      "post": {
        "tags": ["解题助手"],
        "summary": "上传技能包（仅教师）",
        "description": "multipart 表单，文件字段名 `file`，仅支持 .zip，≤512KB。包根目录必须包含 `SKILL.md`（frontmatter 至少含 name、description，可选 适用条件、allowed-tools、resources）；可选目录 references/、assets/、scripts/。\n\n安全校验：拒绝绝对路径、`..` 穿越、反斜杠穿越、符号链接、重复路径与非 UTF-8 内容；解压总量 ≤2MB、文件数 ≤200、单文件 ≤512KB。新技能默认停用，脚本不会被执行。",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": { "type": "string", "format": "binary", "description": ".zip 技能包，≤512KB，根目录含 SKILL.md" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "技能包创建成功（默认停用）",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SkillPackageView" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": {
            "description": "本班已存在同名技能包",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "本班已存在同名技能包" } } }
          }
        }
      }
    },
    "/api/tutor/assistant/skills/{id}": {
